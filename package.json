{
  "name": "leadforge-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prisma:generate": "npx prisma generate",
    "prebuild": "npm run prisma:generate",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','server.js']) fs.rmSync(path,{recursive:true,force:true})\"",
    "prelint": "npm run prisma:generate",
    "lint": "tsc --noEmit",
    "pretest": "npm run prisma:generate",
    "test": "vitest run",
    "test:integration": "vitest run tests/app_comprehensive.test.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.2",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "undici": "^7.29.0",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "undici": "^7.29.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "core-js": true,
    "protobufjs": true,
    "prisma": true,
    "@prisma/engines": true,
    "@prisma/client": true,
    "esbuild": true,
    "bcrypt": true,
    "bcryptjs": true,
    "msgpackr-extract@3.0.4": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.22.0",
    "uuid": "^11.1.1"
  }
}

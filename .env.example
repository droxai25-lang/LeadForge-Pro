# ─── LeadForge Pro required secrets ──────────────────────────────────────────
# All secrets below are REQUIRED. The server refuses to start when any of the
# security-critical values are missing or weaker than the stated minimum.

# Local Ollama. The Docker app reaches the Windows host through
# host.docker.internal. Direct host execution can use http://127.0.0.1:11434.
# Remote endpoints must use HTTPS and require OLLAMA_API_KEY.
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_API_KEY=""

# JWT signing secret — REQUIRED, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=""

# Token hash secret — REQUIRED, at least 32 characters. This is separate from
# JWT_SECRET and is used to bind opaque token hashes to the server.
TOKEN_HASH_SECRET=""

# AES-256 key for encrypting SMTP mailbox passwords at rest.
# 64-character hex string (32 bytes). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MAILBOX_ENCRYPTION_KEY=""

# Shared secret verifying inbound-reply webhooks (HMAC-SHA256) — at least 32 chars.
INBOUND_WEBHOOK_SECRET=""

# HMAC secret for signed recipient unsubscribe links — at least 32 chars.
UNSUBSCRIBE_SECRET=""

# HMAC secret for delivery, bounce, and complaint provider events — at least 32 chars.
DELIVERY_WEBHOOK_SECRET=""

# The private local stack creates this owner only when the database has no
# users. The password is bcrypt-hashed and is never logged.
OWNER_EMAILS="owner@example.com"
OWNER_PASSWORD=""

# Comma-separated allow-list of CORS origins (empty = same-origin only).
# LOCAL_ONLY_MODE rejects non-loopback origins.
CORS_ORIGINS=""

# Public base URL used for redirects/self-referential links.
APP_URL=""
CALENDAR_URL=""

# One password is shared by the PostgreSQL container, the containerized app,
# and host-side Prisma commands. Replace this example value in .env.
POSTGRES_APP_PASSWORD=""
POSTGRES_HOST_PORT=55432
# DATABASE_URL is derived from POSTGRES_APP_PASSWORD and POSTGRES_HOST_PORT.
# For a separately managed database, omit POSTGRES_APP_PASSWORD and set
# DATABASE_URL explicitly instead.

# Redis-compatible connection. Cache reads can degrade, but BullMQ campaign
# dispatch requires a real shared service and never falls back to memory.
REDIS_HOST_PORT=56379
REDIS_URL="redis://127.0.0.1:56379"

# Keyless zero-seed company discovery uses Overture Places (source-dependent
# CDLA Permissive 2.0, Apache 2.0, or CC0) plus a locally cached GeoNames city
# dump (CC BY 4.0). No lead-vendor API key is required. Set false only to
# disable this external-data workflow.
OVERTURE_DISCOVERY_ENABLED="true"
OVERTURE_DUCKDB_EXTENSION_DIR="./.runtime/duckdb_extensions"
GEONAMES_DATA_DIR="./.runtime/geonames"

# Optional named-person enrichment after keyless company discovery. Hunter's
# documented "test-api-key" returns dummy records and is intentionally rejected.
HUNTER_DISCOVERY_ENABLED="false"
HUNTER_API_KEY=""
# Hard ceiling enforced per run; each run also requires an explicit lower or
# equal maximum before it is queued. Paid jobs are never retried automatically.
HUNTER_MAX_EMAIL_CREDITS_PER_RUN=25

# Whether outbound SMTP sending is enabled. When false, dispatches are QUEUED
# and never claimed as sent (processing-integrity enforcement).
SMTP_SENDING_ENABLED="false"

# Allow-list vendor SMTP hosts reachable for real dispatch (comma-separated).
ALLOWED_SMTP_HOSTS="smtp.gmail.com,smtp.office365.com,smtp.zoho.com"
ALLOWED_SMTP_PORTS="465,587"

# Never enable outside trusted dev: disables SMTP TLS certificate validation.
ALLOW_INSECURE_SMTP_TLS="false"

# SMTP transport used for password-reset emails (forgot/reset-password flow).
# Only used when SMTP_SENDING_ENABLED="true". Host/port/user/pass are the same
# transport used for real campaign dispatch.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="sales@example.com"
SMTP_PASS="smtp_secure_password"
SMTP_FROM_NAME="LeadForge Sales"

# Port and log file.
PORT=3000
LOG_FILE="./logs/leadforge-audit.jsonl"
# Raw crawl snapshots are automatically purged after this many days while
# retaining the URL, outcome, timestamp, byte count, and SHA-256 evidence metadata.
CRAWL_EVIDENCE_RETENTION_DAYS=180
# Self-registration is disabled unless explicitly enabled. Existing domains
# always require an administrator invitation and can never be joined by suffix.
PUBLIC_REGISTRATION_ENABLED=false
ENABLE_DEVELOPMENT_ROUTES=false
# Private operator mode is the safe default. It rejects public application
# URLs, non-loopback CORS origins, and live SMTP sending.
LOCAL_ONLY_MODE="true"
CONTAINERIZED="false"
HOST="127.0.0.1"
